node_modules/
packages/*/dist/
*.tsbuildinfo

# Test debris: the sandbox-daemon / fs-k8s / subprocess-k8s suites create their
# working roots inside the package directory.
packages/*/.tmp-*/
packages/*/.dbg*/
packages/*/.smoke-*

# Verification debris at the repo root: `scripts/harness-profile.sh` builds a
# throwaway DSH home under a `.tmp-*` name, and verification runs tee their logs
# next to it. None of it is source.
.tmp-*
