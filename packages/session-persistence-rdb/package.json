{
  "name": "@visecy/dsh-session-persistence-rdb",
  "version": "0.1.22",
  "description": "Vendored RDB durable session persistence backend for the DeepSeek Harness (based on @morlay/session-persistence-rdb)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./invariant": "./src/invariant.ts",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
